# ── Environment ──────────────────────────────────────────────────────────────
# dev | preprod | prod
ENV=dev

# ── Database (Postgres en Docker, volumen en D:/Arbol Genealogico/data/pg_data) ──
POSTGRES_DB=arbol
POSTGRES_USER=arbol
POSTGRES_PASSWORD=arbol
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://arbol:arbol@localhost:5433/arbol
PGADMIN_PORT=8081
PGADMIN_EMAIL=admin@local.test
PGADMIN_PASSWORD=admin

# ── Scraper AHEB-BEHA ─────────────────────────────────────────────────────────
SCRAPER_BASE_URL=https://internet.aheb-beha.org
SCRAPER_USER_AGENT=arbol-genealogico/0.1 (uso genealogico personal; contacto: tu-email@example.com)
SCRAPER_MIN_DELAY_S=0.8
SCRAPER_MAX_DELAY_S=1.6
SCRAPER_MAX_RETRIES=5
SCRAPER_RAW_DIR=D:/Arbol Genealogico/data/raw

# ── App ──────────────────────────────────────────────────────────────────────
# Ruta al fichero de configuración YAML (relativa a la raíz del repo)
CONFIG_PATH=config/config.yaml
